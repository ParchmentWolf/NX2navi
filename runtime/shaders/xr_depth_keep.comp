#version 450
// VR's depth stereo (runtime/vk_xr.cpp vk_xr_keep_depth): the scene's depth, as it is once the scene is drawn, into an
// image of VR's own, which the game's later passes do not draw over
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D depth;
layout(binding = 1, r32f) uniform writeonly image2D kept;
layout(push_constant) uniform Push {
    ivec2 size;
} p;

void main() {
    const ivec2 at = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(at, p.size))) return;
    imageStore(kept, at, vec4(texelFetch(depth, at, 0).r));
}
